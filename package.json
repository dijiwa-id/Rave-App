{
  "name": "rave",
  "private": true,
  "version": "0.3.0",
  "description": "RAVE — Rolliemonkie Audio Visual Experiment: platform ekosistem musik DIY & indie (microservices monorepo)",
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "apps/*"
  ],
  "scripts": {
    "db:start": "bash scripts/dev-db.sh start",
    "db:stop": "bash scripts/dev-db.sh stop",
    "db:reset": "bash scripts/dev-db.sh reset",
    "migrate": "node --import tsx scripts/migrate-all.ts",
    "seed": "node --import tsx scripts/seed-all.ts",
    "dev:services": "node --import tsx scripts/dev-services.ts",
    "dev:web": "npm run dev -w @rave/web",
    "dev": "node --import tsx scripts/dev-all.ts",
    "test": "vitest run",
    "e2e": "node --import tsx scripts/e2e.ts",
    "e2e:isolated": "node --import tsx scripts/e2e-isolated.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "bash scripts/rave.sh start",
    "stop": "bash scripts/rave.sh stop",
    "status": "bash scripts/rave.sh status",
    "logs": "bash scripts/rave.sh logs",
    "db:init": "node --import tsx scripts/db-init.ts",
    "prod:preflight": "bash scripts/prod-preflight.sh",
    "prod:build": "bash scripts/prod.sh build",
    "prod:up": "bash scripts/prod.sh up",
    "prod:down": "bash scripts/prod.sh down",
    "prod:status": "bash scripts/prod.sh status",
    "prod:logs": "bash scripts/prod.sh logs",
    "prod:smoke": "bash scripts/prod.sh smoke",
    "prod:backup": "bash scripts/prod.sh backup",
    "prod:backup-verify": "bash scripts/prod.sh backup-verify",
    "backup:verify": "bash scripts/backup-verify.sh",
    "release": "node --import tsx scripts/release.ts",
    "release:dry": "node --import tsx scripts/release.ts auto --dry-run",
    "version:show": "node -p \"require('./package.json').version\"",
    "monitor": "node --import tsx scripts/monitor.ts",
    "monitor:prod": "node --import tsx scripts/monitor.ts --prod",
    "loadtest": "node --import tsx scripts/loadtest.ts",
    "loadtest:playback": "node --import tsx scripts/loadtest.ts --scenario playback",
    "loadtest:checkout": "node --import tsx scripts/loadtest.ts --scenario checkout",
    "loadtest:browse": "node --import tsx scripts/loadtest.ts --scenario browse"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
