# ---- Shared ----
NODE_ENV=development
# Satu instance Postgres, satu schema per service (database-per-service secara logis).
DATABASE_URL=postgres://rave:rave@127.0.0.1:55432/rave
# Port cluster Postgres lokal (scripts/dev-db.sh, ./rave, e2e:isolated). Ubah bersama DATABASE_URL bila 55432 bentrok.
RAVE_PGPORT=55432
# HS256 untuk dev. Produksi: RS256 + JWKS dari IAM (lihat docs/ARCHITECTURE.md).
JWT_SECRET=dev-only-change-me-please-32-bytes-min
# Event bus driver: "pg" (lokal, tanpa Docker) atau "kafka" (Redpanda/Kafka)
BUS_DRIVER=pg
KAFKA_BROKERS=127.0.0.1:19092
# Secret untuk tanda tangan URL streaming & webhook PG mock
MEDIA_SIGNING_SECRET=dev-media-signing-secret
PG_WEBHOOK_SECRET=dev-pg-webhook-secret
# Adapter payment gateway untuk refund (services/finance/src/providers.ts). Saat ini: sandbox (tidak memindahkan uang).
PAYMENT_PROVIDER=sandbox
INTERNAL_SERVICE_SECRET=dev-internal-service-secret

# ---- Ports ----
GATEWAY_PORT=8080
IAM_PORT=4001
CATALOG_PORT=4002
LIBRARY_PORT=4003
PLAYBACK_PORT=4004
BOOKING_PORT=4005
FINANCE_PORT=4006
TICKETING_PORT=4007
NOTIFICATION_PORT=4008
