# /etc/rave/monitor.env — secret & override RAVE monitor. Pasang: root:root, chmod 600 (scripts/install-monitor.sh).
# Format systemd EnvironmentFile: KEY=nilai per baris, tanpa `export`; kutip ganda bila ada spasi. Lihat docs/OPERATIONS.md §2.

# ---- Email (kanal utama) ----
# Penerima, pisahkan dengan koma. Boleh juga diletakkan di .env.production (bukan secret).
ALERT_EMAIL_TO=
# Pengirim. Untuk Gmail harus alamat akun itu sendiri (atau alias terverifikasi).
ALERT_EMAIL_FROM=
# SMTP — berjalan tanpa menunggu vendor email platform (#28). Gmail: buat App Password (butuh 2FA), lalu:
#   ALERT_SMTP_URL=smtps://akun%40gmail.com:APPPASSWORDTANPASPASI@smtp.gmail.com:465
# (karakter khusus di user/password wajib di-URL-encode: @ → %40, spasi → %20) atau pakai variabel terpisah:
#   ALERT_SMTP_HOST=smtp.gmail.com
#   ALERT_SMTP_PORT=465
#   ALERT_SMTP_USER=akun@gmail.com
#   ALERT_SMTP_PASS="abcd efgh ijkl mnop"
ALERT_SMTP_URL=
# Alternatif setelah Resend produksi aktif (#28): kosongkan ALERT_SMTP_*, isi ALERT_EMAIL_PROVIDER=resend dan
# RESEND_API_KEY (dibaca dari .env.production bila tidak di sini). ALERT_EMAIL_FROM harus domain terverifikasi Resend.
# ALERT_EMAIL_PROVIDER=resend

# ---- Webhook (opsional, tambahan) ----
# Slack/Discord dikenali otomatis; Telegram: URL https://api.telegram.org/bot<token>/sendMessage + ALERT_TELEGRAM_CHAT_ID.
# ALERT_WEBHOOK_URL=
# ALERT_TELEGRAM_CHAT_ID=

# ---- Perilaku ----
# ALERT_MIN_LEVEL=WARN            # atau CRITICAL
# ALERT_REPEAT_MIN=60             # pengingat selama masalah sama masih ada
# ALERT_WARN_CONFIRM_RUNS=2       # WARN dikirim setelah 2 putaran berturut-turut (10 mnt); CRITICAL langsung
# MONITOR_HEARTBEAT_URL=          # healthchecks.io / Better Stack heartbeat: berteriak bila timer berhenti
# MONITOR_BACKUP_WARN_HOURS=26
# MONITOR_BACKUP_CRIT_HOURS=50
