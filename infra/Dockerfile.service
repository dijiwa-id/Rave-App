# Image generik untuk semua microservice GEMA (monorepo).
# Build: docker build -f infra/Dockerfile.service --build-arg SERVICE=booking -t gema/booking .
FROM node:22-alpine AS deps
WORKDIR /repo
COPY package.json package-lock.json* ./
COPY packages ./packages
COPY services ./services
RUN npm ci --omit=dev --workspaces --include-workspace-root --ignore-scripts || npm install --omit=dev --ignore-scripts

FROM node:22-alpine
ARG SERVICE
ENV NODE_ENV=production SERVICE=${SERVICE}
WORKDIR /repo
RUN addgroup -S gema && adduser -S gema -G gema
# Service platform butuh pg_dump (versi ≥ server Postgres) untuk backup.
RUN if [ "$SERVICE" = "platform" ]; then apk add --no-cache postgresql16-client; fi
# Service live butuh ffmpeg (transcoding HLS); ffmpeg-static tidak diunduh karena --ignore-scripts.
RUN if [ "$SERVICE" = "live" ]; then apk add --no-cache ffmpeg; fi
RUN mkdir -p /data/uploads /data/backups /data/live && chown -R gema:gema /data
COPY --from=deps /repo /repo
RUN npm install -g tsx@4
USER gema
WORKDIR /repo/services/${SERVICE}
# Probe: GET /healthz (liveness) & /readyz (readiness, cek DB) — dipakai Helm/K8s.
CMD ["tsx", "src/index.ts"]
