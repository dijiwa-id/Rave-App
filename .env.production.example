# =====================================================================
# RAVE — konfigurasi PRODUCTION (docker-compose.prod.yml)
# Salin ke .env.production (JANGAN di-commit), isi semua nilai bertanda WAJIB,
# lalu jalankan `npm run prod:preflight` sebelum deploy.
# Buat secret acak:  openssl rand -hex 32
# =====================================================================

# ---- Rilis & image ----
# WAJIB. Versi yang di-deploy (= package.json root / tag git vX.Y.Z tanpa "v").
RAVE_VERSION=0.1.0
# Registry image. Lokal: rave. GHCR: ghcr.io/<org>  (lihat .github/workflows/release.yml)
RAVE_REGISTRY=rave

# ---- Domain & jaringan ----
# WAJIB. URL publik web (dipakai link verifikasi kontrak, CORS, email).
PUBLIC_WEB_URL=https://rave.example.id
# Profil tls (Caddy): domain & email Let's Encrypt. Set WEB_BIND=127.0.0.1:8081 agar port 80 dipakai Caddy.
RAVE_DOMAIN=rave.example.id
ACME_EMAIL=ops@rave.example.id
WEB_BIND=80
# Origin tambahan yang boleh memanggil API lintas-origin (dipisah koma). Kosong = hanya PUBLIC_WEB_URL.
CORS_ORIGINS=
# URL RTMP yang ditampilkan ke artis untuk OBS/Larix.
LIVE_RTMP_PUBLIC_URL=rtmp://rave.example.id:1935/live

# ---- Database ----
# WAJIB. Password Postgres container (hex/alfanumerik — dipakai di dalam URL).
POSTGRES_PASSWORD=
# Opsional: DB terkelola (RDS/Cloud SQL). Kosong = Postgres di compose.
# DATABASE_URL=postgres://rave:<password>@db.internal:5432/rave?sslmode=require

# ---- Secret aplikasi (WAJIB, ≥ 32 karakter, unik per lingkungan) ----
JWT_SECRET=
INTERNAL_SERVICE_SECRET=
MEDIA_SIGNING_SECRET=
PG_WEBHOOK_SECRET=
# Kunci enkripsi kolom KYC (AES-256-GCM). JANGAN diganti setelah ada data — data lama tidak bisa dibaca.
KYC_KEY=

# ---- Integrasi pihak ketiga ----
# sandbox = tidak memindahkan uang. Ganti ke adapter PG nyata sebelum menerima pembayaran sungguhan.
PAYMENT_PROVIDER=sandbox
# Event bus: pg (satu host, tanpa Kafka) | kafka (aktifkan --profile kafka atau isi KAFKA_BROKERS)
BUS_DRIVER=pg
# KAFKA_BROKERS=redpanda:9092

# ---- Integrasi (email & payment gateway) ----
# Disarankan diatur Super Admin di dasbor: Platform → Integrasi (API key terenkripsi di DB, bisa diganti tanpa restart).
# Nilai env di bawah hanya dipakai bila dasbor belum diatur. Kunci enkripsi rahasia integrasi:
# INTEGRATIONS_KEY (opsional; default diturunkan dari KYC_KEY). Mengganti kunci = isi ulang API key di dasbor.
# INTEGRATIONS_KEY=
# PAYMENT_PROVIDER: sandbox | midtrans
PAYMENT_PROVIDER=sandbox
# MIDTRANS_MODE=sandbox          # sandbox | production
# MIDTRANS_SERVER_KEY=
# MIDTRANS_CLIENT_KEY=
# Payment Notification URL di dasbor Midtrans: <PUBLIC_WEB_URL>/v1/webhooks/pg/midtrans

# ---- Pengirim OTP & notifikasi (WAJIB sebelum go-live — docs/GO-LIVE.md §P0 #1) ----
# EMAIL_PROVIDER: log (tidak mengirim) | resend | mailgun | postmark | webhook (relay sendiri, body ditandatangani HMAC)
EMAIL_PROVIDER=log
EMAIL_FROM="RAVE <no-reply@rave.example.id>"
# RESEND_API_KEY=
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=mg.rave.example.id
# MAILGUN_BASE_URL=https://api.mailgun.net
# POSTMARK_SERVER_TOKEN=
# EMAIL_WEBHOOK_URL=
# WHATSAPP_PROVIDER: log | meta (WhatsApp Cloud API) | webhook (BSP lain)
WHATSAPP_PROVIDER=log
# WA_PHONE_NUMBER_ID=
# WA_ACCESS_TOKEN=
# WA_OTP_TEMPLATE=rave_otp
# WA_TEMPLATE_LANG=id
# WHATSAPP_WEBHOOK_URL=
# MESSAGING_WEBHOOK_SECRET=   (default: INTERNAL_SERVICE_SECRET)

# ---- Backup off-site (WAJIB sebelum go-live — docs/DEPLOYMENT.md §Backup & pemulihan) ----
# none | dir | s3 | rclone. Service backup-offsite menyalin dump DB (+ .sha256) dari volume storage ke luar host.
BACKUP_OFFSITE=none
# dir: path host disk kedua / mount NAS (bukan disk yang sama dengan volume Docker).
# BACKUP_OFFSITE_DIR=/mnt/backup/rave
# s3: bucket S3/S3-compatible. Kredensial via backend s3 rclone (kunci khusus, hanya untuk prefix ini).
# BACKUP_S3_URI=s3://rave-backup/prod
# RCLONE_S3_PROVIDER=AWS            # AWS | Cloudflare | Wasabi | Minio | GCS | Other
# RCLONE_S3_REGION=ap-southeast-3
# RCLONE_S3_ENDPOINT=               # wajib untuk R2/Wasabi/MinIO
# RCLONE_S3_ACCESS_KEY_ID=
# RCLONE_S3_SECRET_ACCESS_KEY=
# rclone: remote apa pun yang didukung rclone, didefinisikan lewat env, mis. Backblaze B2:
# BACKUP_RCLONE_REMOTE=b2:rave-backup/prod
# RCLONE_CONFIG_B2_TYPE=b2
# RCLONE_CONFIG_B2_ACCOUNT=
# RCLONE_CONFIG_B2_KEY=
# Retensi off-site (hari, 0 = tidak pernah hapus), jeda sinkron (jam), umur maksimum dump terbaru (jam).
# BACKUP_OFFSITE_KEEP_DAYS=30
# BACKUP_OFFSITE_INTERVAL_HOURS=6
# BACKUP_MAX_AGE_HOURS=30

# ---- Operasional ----
LOG_LEVEL=info
DB_POOL_MAX=10
# Batas body nginx untuk upload master audio (batas efektif: pengaturan storage.max_upload_mb).
RAVE_MAX_UPLOAD=2g
# Seed akun demo DILARANG di produksi kecuali disengaja (staging): RAVE_ALLOW_SEED=1
