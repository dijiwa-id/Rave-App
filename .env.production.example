# =====================================================================
# RAVE — konfigurasi PRODUCTION (docker-compose.prod.yml)
# Salin ke .env.production (JANGAN di-commit), isi semua nilai bertanda WAJIB,
# lalu jalankan `npm run prod:preflight` sebelum deploy.
# Buat secret acak:  openssl rand -hex 32
# =====================================================================

# ---- Rilis & image ----
# WAJIB. Versi yang di-deploy (= package.json root / tag git vX.Y.Z tanpa "v").
RAVE_VERSION=0.1.0
# Registry image. Lokal: rave. GHCR: ghcr.io/<org>  (lihat .github/workflows/release.yml)
RAVE_REGISTRY=rave

# ---- Domain & jaringan ----
# WAJIB. URL publik web (dipakai link verifikasi kontrak, CORS, email).
PUBLIC_WEB_URL=https://rave.example.id
# Profil tls (Caddy): domain & email Let's Encrypt. Set WEB_BIND=127.0.0.1:8081 agar port 80 dipakai Caddy.
RAVE_DOMAIN=rave.example.id
ACME_EMAIL=ops@rave.example.id
WEB_BIND=80
# Origin tambahan yang boleh memanggil API lintas-origin (dipisah koma). Kosong = hanya PUBLIC_WEB_URL.
CORS_ORIGINS=
# URL RTMP yang ditampilkan ke artis untuk OBS/Larix.
LIVE_RTMP_PUBLIC_URL=rtmp://rave.example.id:1935/live

# ---- Database ----
# WAJIB. Password Postgres container (hex/alfanumerik — dipakai di dalam URL).
POSTGRES_PASSWORD=
# Opsional: DB terkelola (RDS/Cloud SQL). Kosong = Postgres di compose.
# DATABASE_URL=postgres://rave:<password>@db.internal:5432/rave?sslmode=require

# ---- Secret aplikasi (WAJIB, ≥ 32 karakter, unik per lingkungan) ----
JWT_SECRET=
INTERNAL_SERVICE_SECRET=
MEDIA_SIGNING_SECRET=
PG_WEBHOOK_SECRET=
# Kunci enkripsi kolom KYC (AES-256-GCM). JANGAN diganti setelah ada data — data lama tidak bisa dibaca.
KYC_KEY=

# ---- Integrasi pihak ketiga ----
# sandbox = tidak memindahkan uang. Ganti ke adapter PG nyata sebelum menerima pembayaran sungguhan.
PAYMENT_PROVIDER=sandbox
# Event bus: pg (satu host, tanpa Kafka) | kafka (aktifkan --profile kafka atau isi KAFKA_BROKERS)
BUS_DRIVER=pg
# KAFKA_BROKERS=redpanda:9092

# ---- Operasional ----
LOG_LEVEL=info
DB_POOL_MAX=10
# Batas body nginx untuk upload master audio (batas efektif: pengaturan storage.max_upload_mb).
RAVE_MAX_UPLOAD=2g
# Seed akun demo DILARANG di produksi kecuali disengaja (staging): RAVE_ALLOW_SEED=1
